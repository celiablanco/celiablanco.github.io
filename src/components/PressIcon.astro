---
/**
 * Small line icon marking what a press link leads to, so a linked title reads
 * as a link before you hover it and you can tell a podcast from an article at
 * a glance. Drawn in `currentColor` so it takes the colour of the text it sits
 * beside, including on hover.
 */
interface Props {
  kind: 'podcast' | 'article' | 'profile';
}

const { kind } = Astro.props;

const label = {
  podcast: 'Podcast episode',
  article: 'Article',
  profile: 'Profile',
}[kind];
---
<svg
  class="press-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label={label}
>
  {kind === 'podcast' && (
    <>
      <rect x="9" y="2.5" width="6" height="11" rx="3" />
      <path d="M5.5 11a6.5 6.5 0 0 0 13 0" />
      <path d="M12 17.5V21" />
    </>
  )}
  {kind === 'article' && (
    <>
      <path d="M4 5.5h12.5v13H5.5a1.5 1.5 0 0 1-1.5-1.5V5.5Z" />
      <path d="M16.5 9H20v8a1.5 1.5 0 0 1-1.5 1.5" />
      <path d="M7 9h6.5M7 12h6.5M7 15h4.5" />
    </>
  )}
  {kind === 'profile' && (
    <>
      <rect x="3" y="4.5" width="18" height="15" rx="2" />
      <circle cx="9" cy="10.5" r="2.2" />
      <path d="M5.9 16.3a3.3 3.3 0 0 1 6.2 0" />
      <path d="M15 9.8h3.4M15 13.2h3.4" />
    </>
  )}
</svg>

<style>
  .press-icon {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
    /* Sits on the text baseline rather than the line box, so it lines up with
       the first line of a title that wraps. */
    vertical-align: -0.13em;
    opacity: 0.75;
  }
</style>
